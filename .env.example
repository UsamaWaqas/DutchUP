# Copy this file to .env and fill in your Supabase project's values
# (Project Settings -> API in the Supabase dashboard).
# Never commit the real .env file or the service_role key.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Direct Postgres connection (for CLI tools / migrations). URL-encode any
# special characters in the password (@ # $ , / etc.).
DIRECT_URL=postgresql://postgres.your-project:your-url-encoded-password@your-pooler-host:5432/postgres
